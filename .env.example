# วิธีง่ายสุด: รัน `neon init` แล้ว Neon CLI จะเขียนค่าจริงลง .env ให้เอง
# หรือคัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจาก Neon Console > เลือกโปรเจกต์ > ปุ่ม Connect

# เว็บใช้ตัวนี้ตอนทำงานปกติ — Pooled connection (host มีคำว่า -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ใช้ตอนรันไฟล์ SQL ด้วย psql เท่านั้น — Direct connection (ปิดตัวเลือก Connection pooling, host ไม่มี -pooler)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# เข้าสู่ระบบ (ใส่ใน .env.local)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="เปลี่ยนเป็นรหัสที่เดายาก"
# สร้างด้วย: openssl rand -base64 32
AUTH_SECRET=""
